---
// H.O.M.E. landing page. Editable content: src/content/landing.json (Decap "Landing page").
// Everything else (section headings, FAQ, leadership/graduation blurbs, resources, EIN, footer lines) is hard-coded here.
import data from '../content/landing.json';
import { marked } from 'marked';
import '../styles/global.css';
import { PRESETS, FONTS, fontHref, themeVars, toCss } from '../theme';

// Join It links: render "#" until real URLs are entered in the CMS.
const link = (u?: string) => (!u || /^JOINIT_/.test(u) ? '#' : u);
const join = link(data.join_url), login = link(data.login_url), portal = link(data.portal_url);
const email = data.contact_email || 'membership@home-wa.org';
const mailto = `mailto:${email}`;
const aboutHtml = marked.parse(data.about_body || '') as string;
const year = new Date().getFullYear();

// Theme (Decap "Theme" group). Preset "current" with no overrides emits nothing, so the default look is unchanged.
const theme = (data as any).theme || {};
const rootCss = toCss(themeVars(theme));
const headFont = FONTS[theme.heading_font] ? theme.heading_font : 'nunito';
// Live demo: ?palette=a|b|c|d|current&font=nunito|sora|jakarta|grotesk applies a preset in the browser only.
const demoJs = `(function(){var q=new URLSearchParams(location.search),P=${JSON.stringify(PRESETS)},F=${JSON.stringify(FONTS)},r=document.documentElement.style,p=q.get('palette'),f=q.get('font');
if(p&&P[p]){if(p==='current'){document.addEventListener('DOMContentLoaded',function(){var s=document.getElementById('theme-vars');if(s)s.remove();});}for(var k in P[p])r.setProperty('--'+k,P[p][k]);}
if(f&&F[f]){var l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family='+F[f].css+'&display=swap';document.head.appendChild(l);r.setProperty('--head',"'"+F[f].family+"',system-ui,sans-serif");}})();`;

const nav = [['about', 'About'], ['programs', 'Programs'], ['benefits', 'Benefits'], ['events', 'Events'], ['faq', 'FAQ']];
const cardStyle = [
  { tile: 'tile-sky', icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>' },
  { tile: 'tile-mint', icon: '<circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><path d="M9 9h.01"></path><path d="M15 9h.01"></path>' },
  { tile: 'tile-teal', icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path>' },
];
const faqs = [
  ['Do I have to be a Christian to join?', 'While our group is rooted in Christian values, everyone is welcome to join.'],
  ['Who can join, and what does it cost?', 'Any homeschooling family. An annual membership is $55 per family and is active until September 1, with no automatic renewal. Dues are non-refundable.'],
  ['Are Kids’ Days drop-off events?', 'No — parents attend with their children.'],
  ['Can I join partway through the year?', 'Yes — you can sign up anytime for access to the events that best support your family: parent meetings, kids and teen events, dances, and graduation.'],
  ['I’m new to homeschooling in Washington. Where do I start?', 'File a Declaration of Intent with your local school district by September 15 each year. The <a href="https://washhomeschool.org" class="textlink">Washington Homeschool Organization</a> walks through the state requirements, and <a href="https://hslda.org" class="textlink">HSLDA</a> covers legal questions. Our parent meetings are a great place to ask the rest.'],
];
const ig = '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5h.01"></path></svg>';
const fb = '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"></path></svg>';
const social = [
  [data.facebook_url, 'Facebook group', 'Members only', fb],
  [data.instagram_url, '@homeeducation2021', 'Instagram', ig],
  [data.teens_instagram_url, '@homestudentleadership', 'Teens on Instagram', ig],
].filter(([u]) => u);
const check = '<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" style="stroke:var(--green-text)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>';
const chev = '<svg class="chev" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>';
const logoAlt = 'H.O.M.E. — Home Oriented Meaningful Education';
const logo = '/uploads/home-logo.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>H.O.M.E. | Home Oriented Meaningful Education</title>
  <meta name="description" content="Home Oriented Meaningful Education (H.O.M.E.) is a faith-based member organization serving homeschooling families in North King and South Snohomish counties, WA, since 1986." />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
  {headFont !== 'nunito' && <link href={fontHref(headFont)} rel="stylesheet" />}
  {rootCss && <style is:inline id="theme-vars" set:html={`:root{${rootCss}}`}></style>}
  <script is:inline set:html={demoJs}></script>
  {data.hero_image && <link rel="preload" as="image" href={data.hero_image} fetchpriority="high" />}
</head>
<body>
<header class="site-header">
  <div class="wrap header-bar">
    <a href="#top" class="logo" aria-label="H.O.M.E. home"><img src={logo} alt={logoAlt} width="1453" height="557" /></a>
    <nav aria-label="Page sections" class="nav-desktop">
      {nav.map(([id, label]) => <a href={`#${id}`} class="navlink">{label}</a>)}
    </nav>
    <nav aria-label="Member actions" class="member-actions">
      <a href={login} class="textlink login-desktop">Member Login</a>
      <a href={join} class="btn btn-primary btn-join"><span class="desk">Join H.O.M.E.</span><span class="mob">Join</span></a>
      <button type="button" class="menubtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="i-open" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="i-close" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </nav>
  </div>
  <nav id="mobile-menu" aria-label="Page sections (mobile)" class="mobile-menu" hidden>
    {nav.map(([id, label]) => <a href={`#${id}`} class="mlink">{label}</a>)}
    <a href={login} class="mlink mlink-login">Member Login</a>
  </nav>
</header>

<main>
  <section id="top" class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <img class="photo hero-photo" src={data.hero_image} alt={data.hero_alt} data-cms-img="hero_image" data-cms-alt="hero_alt" width="1168" height="784" fetchpriority="high" />
      <div class="hero-text">
        <span class="badge">Serving families since 1986</span>
        <h1 id="hero-h" data-cms="hero_headline">{data.hero_headline}</h1>
        <p class="subhead" data-cms="hero_subhead">{data.hero_subhead}</p>
        <div class="btn-row">
          <a href={join} class="btn btn-primary btn-lg">Become a Member</a>
          <a href={login} class="btn btn-secondary btn-lg">Member Login</a>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-h">
    <div class="wrap about-grid">
      <div class="about-text">
        <span class="eyebrow">Who we are</span>
        <h2 id="about-h">A warm community for your homeschooling journey</h2>
        <div class="prose" data-cms-md="about_body" set:html={aboutHtml} />
      </div>
      <img class="photo about-photo" src={data.about_image} alt={data.about_alt} data-cms-img="about_image" data-cms-alt="about_alt" width="1168" height="784" loading="lazy" decoding="async" />
    </div>
  </section>

  <section id="programs" class="section bg-cloud" aria-labelledby="offer-h">
    <div class="wrap stack-40">
      <div class="section-head">
        <span class="eyebrow">What we offer</span>
        <h2 id="offer-h">Activities, field trips, and events for every age</h2>
      </div>
      <div class="cards">
        {data.cards.slice(0, 3).map((c, i) => (
          <article class="card">
            <div aria-hidden="true" class={`tile ${cardStyle[i].tile}`}><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={cardStyle[i].icon} /></div>
            <h3 data-cms={`cards.${i}.title`}>{c.title}</h3>
            <p class="grow" data-cms={`cards.${i}.body`}>{c.body}</p>
            <a href={portal} class="textlink card-link">Learn more →</a>
          </article>))}
      </div>
      <div class="strip">
        {/* Student Leadership Team: client is still confirming this text. */}
        <div class="strip-item bg-sky">
          <h3>Student Leadership Team</h3>
          <p>Teens grow as leaders on a team that serves under the Board to support H.O.M.E., build leadership skills, foster godly character, and promote fellowship among students and families.</p>
        </div>
        <div class="strip-item bg-mint">
          <h3>Graduation</h3>
          <p>Each June, H.O.M.E. sponsors a graduation ceremony personalized to that year’s graduating class — a special rite of passage, given the honor and significance it deserves.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="benefits" class="section" aria-labelledby="benefits-h">
    <div class="wrap benefits-grid">
      <div class="b-head">
        <span class="eyebrow">Member benefits</span>
        <h2 id="benefits-h">What membership includes</h2>
        <p class="b-cost" data-cms="benefits_cost">{data.benefits_cost}</p>
      </div>
      <ul class="checklist" data-cms-list="benefits_items">
        {data.benefits_items.map((t) => <li><Fragment set:html={check} /><span>{t}</span></li>)}
      </ul>
      <a href={join} class="btn btn-primary b-btn">Become a Member</a>
    </div>
  </section>

  <section id="events" class="events" aria-labelledby="events-h">
    <div class="wrap events-row">
      <div class="events-text">
        <div aria-hidden="true" class="tile tile-white tile-56"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg></div>
        <div class="stack-10">
          <h2 id="events-h">Events and calendar</h2>
          <p>Our event calendar is for members, and events are hidden for safety and security reasons. Members can see and register for events through our member portal. Not a member yet but curious? Email us and we’ll tell you what’s coming up.</p>
        </div>
      </div>
      <div class="events-actions">
        <a href={portal} class="btn btn-primary btn-lg">See Events (members)</a>
        <a href={mailto} class="textlink"><span class="desk">Not a member? </span>Email us for info</a>
      </div>
    </div>
  </section>

  <section id="faq" class="section" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div class="faq-head">
        <span class="eyebrow">Good to know</span>
        <h2 id="faq-h">Questions families ask before joining</h2>
        <p class="faq-intro">Whether you’re just starting to think about homeschooling or have been at it for years, here’s what most families want to know first.</p>
      </div>
      <div class="faq-list">
        {faqs.map(([q, a], i) => (
          <details class="faq" open={i === 0}>
            <summary><h3>{q}</h3><Fragment set:html={chev} /></summary>
            <p set:html={a} />
          </details>))}
      </div>
      <div class="ask-card">
        <div aria-hidden="true" class="tile tile-white tile-48 green"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.6-.8L3 21l1.9-5.4A8.4 8.4 0 1 1 21 11.5z"></path><path d="M12 8v4"></path><path d="M12 15h.01"></path></svg></div>
        <h3>Still have a question?</h3>
        <p>Send us a note and a board member will get back to you. Or come to your first parent meeting — it’s free<span class="desk">, and it’s the easiest way to meet us</span>.</p>
        <a href={mailto} class="btn btn-secondary ask-btn">Email us</a>
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-h">
    <div class="wrap cta-inner">
      <h2 id="cta-h">Ready to join our community?</h2>
      <p>Membership signup takes just a few minutes.</p>
      <a href={join} class="btn btn-on-dark btn-lg">Become a Member</a>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <img class="f-logo" src={logo} alt={logoAlt} width="1453" height="557" loading="lazy" />
    <div class="f-text">
      <span>H.O.M.E. is a registered nonprofit organization committed to serving our community.</span>
      <span>Federal Tax ID (EIN): 91-1731504 · Serving North King and South Snohomish counties since 1986</span>
    </div>
    {social.length > 0 && <div class="f-follow">
      <span class="f-head">Follow along</span>
      {social.map(([u, label, sub, icon]) => (
        <a href={u} class="social" target="_blank" rel="noopener">
          <span aria-hidden="true" class="s-icon" set:html={icon} />
          <span class="s-text"><span class="s-label">{label}</span><span class="s-sub">{sub}</span></span>
        </a>))}
    </div>}
    <div class="f-res">
      <span class="f-head">Resources</span>
      <a href="https://washhomeschool.org" class="textlink f-row" target="_blank" rel="noopener">Washington Homeschool Organization</a>
      <a href="https://hslda.org" class="textlink f-row" target="_blank" rel="noopener">Home School Legal Defense Association</a>
    </div>
    <div class="f-contact">
      <a href={mailto} class="textlink f-row" data-cms="contact_email">{email}</a>
      <a href={login} class="textlink f-row">Member Login</a>
    </div>
    <span class="f-copy">© {year} H.O.M.E. All rights reserved.</span>
  </div>
</footer>

<a href="#top" class="totop" aria-label="Back to top" hidden><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path></svg></a>

<script>
  // Mobile menu toggle (closes on link tap and Escape) and mobile back-to-top button.
  const btn = document.querySelector<HTMLButtonElement>('.menubtn')!;
  const menu = document.getElementById('mobile-menu')!;
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn.addEventListener('click', () => setMenu(menu.hidden));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); btn.focus(); } });
  const top = document.querySelector<HTMLAnchorElement>('.totop')!;
  const onScroll = () => { top.hidden = window.scrollY < 600; };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
</body>
</html>
