---
import raw from '../content/home/index.yml?raw';
import yaml from 'js-yaml';
import { marked } from 'marked';
import '../styles/global.css';

const data: any = yaml.load(raw);
const { site, links, contact, header, sections = [], footer } = data;

// Join It placeholders (or empty values) render as "#" so the layout can be previewed.
const url = (u?: string) => (!u || /^JOINIT_/.test(u) ? '#' : u);
const join = url(links?.join), login = url(links?.login), portal = url(links?.portal);
const mailto = contact?.email ? `mailto:${contact.email}` : '#';
const md = (s = '') => marked.parse(s) as string;
const mdInline = (s = '') => marked.parseInline(s) as string;
const year = new Date().getFullYear();

const icons: Record<string, string> = {
  parents: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  kids: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
  teens: '<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  instagram: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  menu: '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>',
};
const svg = (n: string, size = 24) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[n] ?? ''}</svg>`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{site.title}</title>
  <meta name="description" content={site.description} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body>
<header class="site-header">
  <div class="wrap header-inner">
    <a href="#top" class="logo"><img src={site.logo} alt={site.logo_alt} width="1453" height="557" /></a>
    <nav aria-label="Main" class="nav-desktop">
      {header.nav.map((n: any) => <a class="nav-link" href={`#${n.anchor}`}>{n.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="text-link login-desktop" href={login}>{header.login_label}</a>
      <a class="btn btn-primary btn-sm" href={join}>{header.join_label}</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" set:html={svg('menu')} />
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
    {header.nav.map((n: any) => <a href={`#${n.anchor}`}>{n.label}</a>)}
    <a class="btn btn-secondary" href={login}>{header.login_label}</a>
  </nav>
</header>

<main>
{sections.map((s: any) => {
  const hid = `${s.anchor}-h`;
  switch (s.type) {
    case 'hero': return (
      <section id={s.anchor} class="hero bg-cloud" aria-labelledby={hid}>
        <div class="wrap two-col">
          <div class="hero-media">
            {s.image ? <img class="photo" src={s.image} alt={s.image_alt} width="1168" height="784" fetchpriority="high" />
              : <div class="photo placeholder sky"><span set:html={svg('image', 32)} /><strong>{s.image_placeholder}</strong></div>}
          </div>
          <div class="hero-text">
            {s.badge && <span class="badge">{s.badge}</span>}
            <h1 id={hid}>{s.headline}</h1>
            <p class="subhead">{s.subhead}</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={join}>{s.primary_label}</a>
              <a class="btn btn-secondary" href={login}>{s.secondary_label}</a>
            </div>
          </div>
        </div>
      </section>);
    case 'about': return (
      <section id={s.anchor} class="section" aria-labelledby={hid}>
        <div class="wrap two-col about">
          <div class="about-media">
            {s.image ? <img class="photo" src={s.image} alt={s.image_alt} width="1168" height="784" loading="lazy" />
              : <div class="photo placeholder mint"><span set:html={svg('image', 32)} /><strong>{s.image_placeholder}</strong></div>}
          </div>
          <div>
            <p class="eyebrow">{s.eyebrow}</p>
            <h2 id={hid}>{s.heading}</h2>
            <div class="prose" set:html={md(s.body)} />
          </div>
        </div>
      </section>);
    case 'programs': return (
      <section id={s.anchor} class="section bg-cloud" aria-labelledby={hid}>
        <div class="wrap">
          <p class="eyebrow">{s.eyebrow}</p>
          <h2 id={hid} class="narrow">{s.heading}</h2>
          <div class="cards">
            {(s.cards ?? []).map((c: any) => (
              <article class="card">
                <span class={`icon-tile icon-${c.icon}`} set:html={svg(c.icon)} />
                <h3>{c.title}</h3>
                <p class="card-body">{c.body}</p>
                <a class="text-link" href={portal}>{s.link_label} →</a>
              </article>))}
          </div>
          <div class="extras">
            {(s.extras ?? []).map((e: any) => (
              <div class={`extra ${e.tone}`}><h3>{e.title}</h3><p>{e.body}</p></div>))}
          </div>
        </div>
      </section>);
    case 'benefits': return (
      <section id={s.anchor} class="section" aria-labelledby={hid}>
        <div class="wrap two-col benefits">
          <div>
            <p class="eyebrow">{s.eyebrow}</p>
            <h2 id={hid}>{s.heading}</h2>
            <p class="lead">{s.cost}</p>
            <a class="btn btn-primary full-mobile" href={join}>{s.button_label}</a>
          </div>
          <ul class="checklist">
            {(s.items ?? []).map((i: string) => <li><span set:html={svg('check', 20)} />{i}</li>)}
          </ul>
        </div>
      </section>);
    case 'events': return (
      <section id={s.anchor} class="events bg-sky" aria-labelledby={hid}>
        <div class="wrap events-inner">
          <span class="icon-tile white" set:html={svg('calendar')} />
          <div class="events-text">
            <h2 id={hid}>{s.heading}</h2>
            <p>{s.body}</p>
          </div>
          <div class="events-actions">
            <a class="btn btn-primary full-mobile" href={portal}>{s.button_label}</a>
            <a class="text-link" href={mailto}>{s.email_label}</a>
          </div>
        </div>
      </section>);
    case 'faq': return (
      <section id={s.anchor} class="section" aria-labelledby={hid}>
        <div class="wrap two-col faq">
          <div class="faq-intro">
            <p class="eyebrow">{s.eyebrow}</p>
            <h2 id={hid}>{s.heading}</h2>
            <p class="lead">{s.intro}</p>
            <div class="ask-card desk-only">
              <span class="icon-tile white" set:html={svg('chat')} />
              <h3>{s.card_heading}</h3><p>{s.card_body}</p>
              <a class="btn btn-secondary btn-sm" href={mailto}>{s.card_button}</a>
            </div>
          </div>
          <div class="faq-list">
            {(s.items ?? []).map((q: any, i: number) => (
              <details open={i === 0}>
                <summary><h3>{q.question}</h3><span class="chev" set:html={svg('chevron', 20)} /></summary>
                <div class="answer" set:html={md(q.answer)} />
              </details>))}
          </div>
          <div class="ask-card mobile-only">
            <span class="icon-tile white" set:html={svg('chat')} />
            <h3>{s.card_heading}</h3><p>{s.card_body}</p>
            <a class="btn btn-secondary btn-sm" href={mailto}>{s.card_button}</a>
          </div>
        </div>
      </section>);
    case 'cta': return (
      <section id={s.anchor} class="cta" aria-labelledby={hid}>
        <div class="wrap center">
          <h2 id={hid}>{s.heading}</h2>
          <p>{s.body}</p>
          <a class="btn btn-green full-mobile" href={join}>{s.button_label}</a>
        </div>
      </section>);
    default: return null;
  }
})}
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="f-brand">
      <img src={site.logo} alt={site.logo_alt} width="1453" height="557" loading="lazy" class="f-logo" />
      <p>{footer.nonprofit}</p>
      <p>Federal Tax ID (EIN): {footer.ein} · {footer.serving}</p>
    </div>
    <div>
      <p class="f-head">{footer.social_heading}</p>
      <ul class="f-social">
        {(footer.social ?? []).filter((x: any) => x.url).map((x: any) => (
          <li><a href={x.url} target="_blank" rel="noopener"><span class="icon-tile sm" set:html={svg(x.icon, 18)} /><span><strong>{x.label}</strong><small>{x.sublabel}</small></span></a></li>))}
      </ul>
    </div>
    <div>
      <p class="f-head">{footer.resources_heading}</p>
      <ul class="f-links">
        {(footer.resources ?? []).map((r: any) => <li><a class="text-link" href={r.url} target="_blank" rel="noopener">{r.label}</a></li>)}
      </ul>
    </div>
    <div class="f-contact">
      {contact?.email && <a class="text-link" href={mailto}>{contact.email}</a>}
      <a class="text-link" href={login}>{header.login_label}</a>
      <p class="muted">© {year} {footer.copyright}</p>
    </div>
  </div>
</footer>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); menu.hidden = !open; };
  btn.addEventListener('click', () => set(menu.hidden));
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
</script>
</body>
</html>
