---
// H.O.M.E. landing page. All visitor-facing copy lives in src/content/landing.json (Decap "Landing page").
import data from '../content/landing.json';
import { marked } from 'marked';
import '../styles/global.css';
import { PRESETS, FONTS, BODY_FONTS, BUTTONS, fontLinks, themeVars, toCss } from '../theme';

const md = (s?: string) => marked.parse(s || '') as string;
// Real links only. Empty values and unfinished JOINIT_ placeholders stay unlinked.
const url = (u?: string) => {
  const v = (u || '').trim();
  if (!v || v === '#' || /^JOINIT_/.test(v)) return '';
  return v;
};
const hrefOrHash = (u?: string) => url(u) || '#';
const join = hrefOrHash(data.join_url);
const login = hrefOrHash(data.login_url);
const portal = hrefOrHash(data.portal_url);
const gradHref = url(data.graduation_link_url);
const showImg = (src?: string) => !!url(src) || !!(src && src.trim() && !src.startsWith('#'));
const email = data.contact_email || 'membership@home-wa.org';
const mailto = `mailto:${email}`;
const year = new Date().getFullYear();

// Theme (Decap "Theme" group). Preset "current" and Red Hat (the default) emit nothing, so the CSS defaults hold.
const theme = (data as { theme?: Record<string, string> }).theme || {};
const rootCss = toCss(themeVars(theme));
const extraFonts = fontLinks(theme);
// Live demo only: ?palette=a|b|c|d|current&font=<heading>&body=<body>&buttons=pill|rounded|square
// ?font= also switches the body font to that heading's recommended pairing unless &body= is given.
const demoJs = `(function(){var q=new URLSearchParams(location.search),P=${JSON.stringify(PRESETS)},F=${JSON.stringify(FONTS)},B=${JSON.stringify(BODY_FONTS)},S=${JSON.stringify(BUTTONS)},r=document.documentElement.style,p=q.get('palette'),f=q.get('font'),b=q.get('body'),s=q.get('buttons');
function L(c){var l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family='+c+'&display=swap';document.head.appendChild(l);}
if(p&&P[p]){if(p==='current'){document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('theme-vars');if(e)e.remove();});}for(var k in P[p])r.setProperty('--'+k,P[p][k]);}
if(f&&F[f]){L(F[f].css);r.setProperty('--head',"'"+F[f].family+"',system-ui,sans-serif");if(!b)b=F[f].body;}
if(b&&B[b]){L(B[b].css);r.setProperty('--body',"'"+B[b].family+"',system-ui,sans-serif");}
if(s&&S[s])r.setProperty('--btn-radius',S[s]);})();`;

const nav = [
  ['about', 'About'],
  ['benefits', 'Benefits'],
  ['kids-day', "Kids' Day"],
  ['teens', 'Teens'],
  ['leadership', 'Leadership'],
  ['graduation', 'Graduation'],
  ['contact', 'Contact'],
];
const ig = '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5h.01"></path></svg>';
const fb = '<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"></path></svg>';
const social = [
  [data.facebook_url, 'Facebook group', 'Members only', fb],
  [data.instagram_url, '@homeeducation2021', 'Instagram', ig],
  [data.teens_instagram_url, '@homestudentleadership', 'Teens on Instagram', ig],
].filter(([u]) => u);
const check = '<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" style="stroke:var(--green-text)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>';
const smile = '<circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><path d="M9 9h.01"></path><path d="M15 9h.01"></path>';
const cap = '<path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path>';
const logoAlt = 'H.O.M.E. — Home Oriented Meaningful Education';
const logo = '/uploads/home-logo.png';
const heroOn = showImg(data.hero_image);
const aboutOn = showImg(data.about_image);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{data.meta_title}</title>
  <meta name="description" content={data.meta_description} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@700;800&family=Red+Hat+Text:wght@400;600&display=swap" rel="stylesheet" />
  {extraFonts.map((h) => <link href={h} rel="stylesheet" />)}
  {rootCss && <style is:inline id="theme-vars" set:html={`:root{${rootCss}}`}></style>}
  <script is:inline set:html={demoJs}></script>
  {heroOn && <link rel="preload" as="image" href={data.hero_image} fetchpriority="high" />}
</head>
<body>
<header class="site-header">
  <div class="wrap header-bar">
    <a href="#top" class="logo" aria-label="H.O.M.E. home"><img src={logo} alt={logoAlt} width="1453" height="557" /></a>
    <nav aria-label="Page sections" class="nav-desktop">
      {nav.map(([id, label]) => <a href={`#${id}`} class="navlink">{label}</a>)}
    </nav>
    <nav aria-label="Member actions" class="member-actions">
      <a href={login} class="textlink util-desktop" data-cms-href="login_url">Member Login</a>
      <a href={portal} class="textlink util-desktop" data-cms-href="portal_url">Events</a>
      <a href={join} class="btn btn-primary btn-join" data-cms-href="join_url"><span class="desk">Join H.O.M.E.</span><span class="mob">Join</span></a>
      <button type="button" class="menubtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="i-open" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="i-close" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </nav>
  </div>
  <nav id="mobile-menu" aria-label="Page sections (mobile)" class="mobile-menu" hidden>
    {nav.map(([id, label]) => <a href={`#${id}`} class="mlink">{label}</a>)}
    <a href={portal} class="mlink" data-cms-href="portal_url">Events</a>
    <a href={login} class="mlink mlink-login" data-cms-href="login_url">Member Login</a>
  </nav>
</header>

<main>
  <section id="top" class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="badge" data-cms="hero_badge">{data.hero_badge}</span>
        <h1 id="hero-h" data-cms="hero_headline">{data.hero_headline}</h1>
        <p class="subhead" data-cms="hero_subhead">{data.hero_subhead}</p>
        <div class="btn-row">
          <a href={join} class="btn btn-primary btn-lg" data-cms-href="join_url">Become a Member</a>
          <a href={login} class="btn btn-secondary btn-lg" data-cms-href="login_url">Member Login</a>
        </div>
      </div>
      <figure class="photo-slot hero-photo" data-cms-slot="hero_image" hidden={!heroOn}>
        <img class="photo" src={heroOn ? data.hero_image : undefined} alt={data.hero_alt || ''} data-cms-img="hero_image" data-cms-alt="hero_alt" width="1168" height="784" fetchpriority={heroOn ? 'high' : undefined} />
      </figure>
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-h">
    <div class="wrap about-copy">
      <span class="eyebrow">Who we are</span>
      <h2 id="about-h" data-cms="about_heading">{data.about_heading}</h2>
      <div class="prose" data-cms-md="about_body" set:html={md(data.about_body)} />
      <div class="facts">
        <p data-cms="nonprofit_line">{data.nonprofit_line}</p>
        <p class="ein" data-cms="ein_line">{data.ein_line}</p>
      </div>
    </div>
  </section>

  <section id="benefits" class="section bg-cloud" aria-labelledby="benefits-h">
    <div class="wrap stack">
      <div class="section-head">
        <span class="eyebrow">Membership</span>
        <h2 id="benefits-h" data-cms="benefits_heading">{data.benefits_heading}</h2>
      </div>
      <div class="benefit-list" data-cms-repeater="benefits">
        {data.benefits.map((b) => (
          <article class="benefit">
            <h3 data-field="title">{b.title}</h3>
            <div class="prose" data-field-md="body" set:html={md(b.body)} />
          </article>
        ))}
      </div>
      <div class="join-panel">
        <div class="join-copy">
          <h3 data-cms="join_heading">{data.join_heading}</h3>
          <div class="prose" data-cms-md="join_body" set:html={md(data.join_body)} />
        </div>
        <a href={join} class="btn btn-primary btn-lg" data-cms-href="join_url">Become a Member</a>
        <p class="already">Already a member? <a href={login} class="textlink" data-cms-href="login_url">Log in</a> to see <a href={portal} class="textlink" data-cms-href="portal_url">events</a>.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Kids' Day and teens">
    <div class="wrap split-wrap">
      <figure class="photo-slot feature-slot" data-cms-slot="about_image" hidden={!aboutOn}>
        <img class="photo feature-photo" src={aboutOn ? data.about_image : undefined} alt={data.about_alt || ''} data-cms-img="about_image" data-cms-alt="about_alt" width="1600" height="900" loading="lazy" decoding="async" />
      </figure>
      <div class="split-2">
        <article id="kids-day" class="split-card" aria-labelledby="kids-h">
          <div class="split-head">
            <div aria-hidden="true" class="tile tile-mint"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={smile} /></div>
            <div>
              <span class="eyebrow">Family events</span>
              <h2 id="kids-h" data-cms="kids_heading">{data.kids_heading}</h2>
            </div>
          </div>
          <div class="prose" data-cms-md="kids_body" set:html={md(data.kids_body)} />
        </article>
        <article id="teens" class="split-card" aria-labelledby="teens-h">
          <div class="split-head">
            <div aria-hidden="true" class="tile tile-teal"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={cap} /></div>
            <div>
              <span class="eyebrow">Ages 14 and up</span>
              <h2 id="teens-h" data-cms="teens_heading">{data.teens_heading}</h2>
            </div>
          </div>
          <div class="prose" data-cms-md="teens_body" set:html={md(data.teens_body)} />
        </article>
      </div>
    </div>
  </section>

  <section id="leadership" class="section" aria-labelledby="lead-h">
    <div class="wrap stack">
      <div class="section-head">
        <span class="eyebrow">Students</span>
        <h2 id="lead-h" data-cms="leadership_heading">{data.leadership_heading}</h2>
      </div>
      <div class="prose lead-intro" data-cms-md="leadership_body" set:html={md(data.leadership_body)} />
      <ul class="checklist cols-2" data-cms-list="leadership_points">
        {data.leadership_points.map((t) => <li><Fragment set:html={check} /><span>{t}</span></li>)}
      </ul>
      <p class="notice" data-cms="leadership_status">{data.leadership_status}</p>
      <div class="doc-block">
        <h3 data-cms="leadership_links_heading">{data.leadership_links_heading}</h3>
        <ul class="doc-list" data-cms-repeater="leadership_links">
          {data.leadership_links.map((item) => {
            const href = url(item.url);
            return (
              <li>
                <a class:list={['doc-label', 'optional-link', { textlink: !!href, 'is-pending': !href }]} href={href || undefined} data-field="label" data-field-href="url">{item.label}</a>
                <p class="link-note" data-field="note" data-field-hide-empty="note" hidden={!item.note}>{item.note}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <section id="graduation" class="section grad" aria-labelledby="grad-h">
    <div class="wrap grad-row">
      <div class="grad-copy">
        <span class="eyebrow">Each June</span>
        <h2 id="grad-h" data-cms="graduation_heading">{data.graduation_heading}</h2>
        <div class="prose" data-cms-md="graduation_body" set:html={md(data.graduation_body)} />
        <p class="grad-link">
          <a class:list={['optional-link', { textlink: !!gradHref, 'is-pending': !gradHref }]} href={gradHref || undefined} data-cms="graduation_link_label" data-cms-optional-href="graduation_link_url">{data.graduation_link_label}</a>
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-h">
    <div class="wrap stack">
      <div class="section-head">
        <span class="eyebrow">The board</span>
        <h2 id="contact-h" data-cms="contact_heading">{data.contact_heading}</h2>
      </div>
      <div class="prose contact-intro" data-cms-md="contact_body" set:html={md(data.contact_body)} />
      <ul class="board" data-cms-repeater="board">
        {data.board.map((m) => (
          <li class="board-card">
            <h3 data-field="name">{m.name}</h3>
            <p class="board-role" data-field="role">{m.role}</p>
            <a class="textlink board-email" href={m.email ? `mailto:${m.email}` : undefined} data-field="email" data-field-mailto="email" hidden={!m.email}>{m.email}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-h">
    <div class="wrap cta-inner">
      <h2 id="cta-h" data-cms="cta_heading">{data.cta_heading}</h2>
      <p data-cms="cta_text">{data.cta_text}</p>
      <a href={join} class="btn btn-on-dark btn-lg" data-cms-href="join_url">Become a Member</a>
      <p class="cta-alt">Already a member? <a href={login} data-cms-href="login_url">Log in to see events</a></p>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <img class="f-logo" src={logo} alt={logoAlt} width="1453" height="557" loading="lazy" />
    <div class="f-text" data-cms-list="footer_lines">
      {data.footer_lines.map((line) => <span>{line}</span>)}
    </div>
    {social.length > 0 && <div class="f-follow">
      <span class="f-head">Follow along</span>
      {social.map(([u, label, sub, icon]) => (
        <a href={u} class="social" target="_blank" rel="noopener">
          <span aria-hidden="true" class="s-icon" set:html={icon} />
          <span class="s-text"><span class="s-label">{label}</span><span class="s-sub">{sub}</span></span>
        </a>))}
    </div>}
    <div class="f-res">
      <span class="f-head">Resources</span>
      <div class="contents" data-cms-repeater="resources">
        {data.resources.map((r) => <a href={r.url} class="textlink f-row" data-field="label" data-field-href="url" target="_blank" rel="noopener">{r.label}</a>)}
      </div>
    </div>
    <div class="f-contact">
      <a href={mailto} class="textlink f-row" data-cms="contact_email" data-cms-mailto="contact_email">{email}</a>
      <a href={login} class="textlink f-row" data-cms-href="login_url">Member Login</a>
      <a href={portal} class="textlink f-row" data-cms-href="portal_url">Events</a>
      <a href="#contact" class="textlink f-row">Contact the board</a>
    </div>
    <span class="f-copy">© {year} H.O.M.E. All rights reserved.</span>
  </div>
</footer>

<a href="#top" class="totop" aria-label="Back to top" hidden><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path></svg></a>

<script>
  // Mobile menu toggle (closes on link tap and Escape) and mobile back-to-top button.
  const btn = document.querySelector<HTMLButtonElement>('.menubtn')!;
  const menu = document.getElementById('mobile-menu')!;
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn.addEventListener('click', () => setMenu(menu.hidden));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); btn.focus(); } });
  const top = document.querySelector<HTMLAnchorElement>('.totop')!;
  const onScroll = () => { top.hidden = window.scrollY < 600; };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
</body>
</html>
